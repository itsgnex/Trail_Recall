PLANTNET_API_KEY=your_plantnet_api_key_here
PLANTNET_PROJECT=all
PLANTNET_LANG=en
PLANTNET_ORGAN=auto
PLANT_RESPONSE_AI=true
VERIFY_PLANT_BEFORE_PLANTNET=true
PLANT_VERIFY_MIN_CONFIDENCE=0.70

# Voice profiles:
# fast = smaller Whisper, shorter recordings, quicker wake
# whisper_first = better accuracy, still uses Google only as fallback
VOICE_PROFILE=balanced
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TIMEOUT=4
OLLAMA_MODEL=gemma3:1b
VISION_LLM_MODEL=gemma3:1b
FINAL_RESPONSE_MODEL=gemma3:1b
IMAGE_TASK_MODEL=gemma3:1b
USE_LOCAL_VISION_LLM=false

# Speech-to-text:
# local = faster-whisper on this computer
# openrouter_first = try OpenRouter gpt-4o-mini-transcribe, then local Whisper if the API fails
# openai = skip local Whisper and use OpenAI's transcription API
# openai_first = try OpenAI, then local Whisper if the API fails
STT_PROVIDER=openrouter_first
OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_STT_TIMEOUT_SECONDS=3
LOCAL_STT_TIMEOUT_SECONDS=2
REPLY_MIN_RMS=120
REPLY_MIN_VOICED_MS=150
WAKE_WHISPER_MODEL=tiny.en
WAKE_WHISPER_CPU_THREADS=4
WAKE_TRANSCRIPTION_TIMEOUT_SECONDS=2
WAKE_CAPTURE_SECONDS=2
WAKE_SILENCE_MS=400
WAKE_MIN_RMS=140
WAKE_AMBIENT_MULTIPLIER=2.5
WAKE_MIN_VOICED_MS=250
COMMAND_RECORD_SECONDS=2.5
FOLLOW_UP_RECORD_SECONDS=1.5
FOLLOW_UP_SILENCE_MS=300
CONFIRMATION_RECORD_SECONDS=2
CONFIRMATION_SILENCE_MS=350
VISUAL_PROMPT_COOLDOWN_SECONDS=7
VISUAL_REPLY_MAX_RETRIES=1
VISUAL_OBJECT_GONE_SECONDS=3
VISUAL_OBJECT_GONE_MIN_FRAMES=8
VISUAL_REARM_SCENE_CHANGE_THRESHOLD=18
SPEECH_END_SILENCE_MS=450
LATENCY_WARN_THRESHOLD_MS=1000
LATENCY_LOG_FILE_ENABLED=1
LATENCY_CONSOLE_MODE=summary
LOG_LEVEL=INFO
VISION_LOG_INTERVAL_SECONDS=10
MIC_LOG_INTERVAL_SECONDS=10
TERMINAL_COMPACT_MODE=1
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_TIMEOUT=8

# Wake phrase (comma-separated). Default is accent-friendly "hey look".
# WAKE_PHRASES=hey look,okay look,hey trail,hey glasses,hey assistant

# Phone trail commands over the phone hotspot.
ANDROID_TRAIL_URL=http://192.168.0.91:8766

# Glasses microphone (phone forwards Mentra PCM to Mac port 8767)
USE_GLASSES_MIC=1
